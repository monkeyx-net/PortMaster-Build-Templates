+bool GLDebugChecks() {
+    static const bool enabled = std::getenv("AURORA_GL_DEBUG") != nullptr;
+    return enabled;
+}
+
+void LogGLErrorIfEnabled(const OpenGLFunctions& gl,
+                         const char* call,
+                         const char* file,
+                         const char* function,
+                         unsigned int line) {
+    if (!GLDebugChecks()) {
+        return;
+    }
+    GLenum error = gl.GetError();
+    while (error != GL_NO_ERROR && error != GL_CONTEXT_LOST) {
+        WarningLog() << "GL error: " << call << " failed with " << GLErrorAsString(error) << " at "
+                     << file << ":" << line << " (" << function << ")";
+        error = gl.GetError();
+    }
+}
