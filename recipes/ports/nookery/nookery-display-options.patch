 void update_render_size() {
+    // The widescreen code only widens the 4:3 view. On screens narrower than 4:3 (720x720 handhelds)
+    // stretching crops the HUD and dialogue boxes, so letterbox the 4:3 view there instead.
+    // NOOKERY_ASPECT=4:3 (PortMaster launcher) letterboxes on every screen.
+    static int s_viewportPolicy = -1;
+    static const bool s_force43 = [] {
+        const char* aspect = std::getenv("NOOKERY_ASPECT");
+        return aspect != nullptr && std::strcmp(aspect, "4:3") == 0;
+    }();
+    const AuroraWindowSize windowSize = aurora_get_window_size();
+    if (windowSize.native_fb_width != 0 && windowSize.native_fb_height != 0) {
+        const bool narrow = windowSize.native_fb_width * 3 < windowSize.native_fb_height * 4;
+        const int policy = s_force43 || narrow ? AURORA_VIEWPORT_FIT : AURORA_VIEWPORT_STRETCH;
+        if (policy != s_viewportPolicy) {
+            s_viewportPolicy = policy;
+            AuroraSetViewportPolicy(static_cast<AuroraViewportPolicy>(policy));
+        }
+    }
+
     u32 width = 0;
     u32 height = 0;
     AuroraGetRenderSize(&width, &height);
@@ -596,6 +614,14 @@
 
     aurora_initialize(argc, argv, &config);
     AuroraSetViewportPolicy(AURORA_VIEWPORT_STRETCH);
+    // NOOKERY_RENDER_SCALE=1 (PortMaster launcher) renders at the GameCube's 640x480 instead of the
+    // screen resolution; unset or 0 keeps the native resolution.
+    if (const char* renderScale = std::getenv("NOOKERY_RENDER_SCALE")) {
+        const float scale = std::strtof(renderScale, nullptr);
+        if (scale > 0.f) {
+            VISetFrameBufferScale(scale);
+        }
+    }
     g_pc_window_w = windowDimensions.width;
     g_pc_window_h = windowDimensions.height;
     update_render_size();
