+namespace {
+// Preloaded EGL wrappers (Westonpack's crusty) only redirect some names in eglGetProcAddress; their
+// eglSwapBuffers, which presents through SDL2 (KMSDRM page flip), is only reachable as a global
+// symbol. Prefer the global one (the same libEGL function without a wrapper).
+dawn::native::opengl::EGLGetProcProc g_eglGetProc = nullptr;
+dawn::native::opengl::EGLFunctionPointerType aurora_egl_get_proc(const char* name) {
+  if (std::strcmp(name, "eglSwapBuffers") == 0) {
+    if (void* global = dlsym(RTLD_DEFAULT, name)) {
+      return reinterpret_cast<dawn::native::opengl::EGLFunctionPointerType>(global);
+    }
+  }
+  return g_eglGetProc(name);
+}
+} // namespace
+#endif
