# Upstream source: downloaded by check_updates.sh / fetch_source.sh, pinned by recipe.json
new_ports/*/source/
new_ports/*/source.*
# PortMaster release zips downloaded by check_updates.sh (contents are extracted and tracked)
new_ports/*/*.zip
new_ports/*/*/*.zip
# Built packages (published as GitHub releases)
/*.zip
# On-device test results from test_port.sh (report.md, screenshots, logs, test zip)
new_ports/*/test/
# User-supplied game data placed in a port folder for local testing (never commit or publish)
new_ports/*/*/*/*.iso
new_ports/*/*/*/*.rvz
new_ports/*/*/*/*.gcm
new_ports/*/*/*/*.ciso
